// Optional: let administrators run AeroClean's safe system cleans without
// typing a password. Copy to /etc/polkit-1/rules.d/50-aeroclean.rules
// Package removals and service changes still ask.
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.aeroclean.helper.clean-") === 0 &&
        subject.local && subject.active &&
        (subject.isInGroup("sudo") || subject.isInGroup("wheel") || subject.isInGroup("admin"))) {
        return polkit.Result.YES;
    }
});
